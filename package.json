{
  "name": "inkpage",
  "version": "0.1.0",
  "description": "墨页 — 一款专注书写的 Markdown 桌面编辑器",
  "main": "./out/main/index.js",
  "author": "Inkpage",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "prepare:assets": "node scripts/copy-vditor-assets.mjs",
    "dev": "pnpm run prepare:assets && electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "pnpm run build && node scripts/e2e-smoke.mjs",
    "build": "pnpm run typecheck && pnpm run prepare:assets && electron-vite build",
    "dist": "pnpm run build && electron-builder",
    "dist:dir": "pnpm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vditor": "3.11.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.inkpage.editor",
    "productName": "墨页",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Office",
      "executableName": "inkpage",
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
